{
    "name": "tabdrift",
    "description": "A fast, keyboard-first tab switcher for Firefox",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "license": "MIT",
    "author": "Abdullah Waqar (https://www.abdullahwaqar.com/)",
    "repository": {
        "type": "git",
        "url": "https://github.com/abdullahwaqar/tabdrift.git"
    },
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "version": "node scripts/sync-version.mjs && git add wxt.config.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "typescript": "^5.6.0",
        "wxt": "^0.21.4"
    }
}
