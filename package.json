{
    "name": "tabdrift",
    "description": "A fast, tab switcher",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "compile": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "typescript": "^5.6.0",
        "wxt": "^0.21.4"
    }
}
